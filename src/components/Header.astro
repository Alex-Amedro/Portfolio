---
// src/components/Header.astro
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getTranslation } from '../data/translations';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const navHome = getTranslation(lang, 'nav.home');
const navProjects = getTranslation(lang, 'nav.projects');
const navContact = getTranslation(lang, 'nav.contact');
---

<header class="fixed top-0 left-0 right-0 z-50 bg-bg-light/80 dark:bg-dark-bg/80 backdrop-blur-md border-b border-gray-200 dark:border-slate-700">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href={`/${lang}`} class="text-2xl font-bold text-primary dark:text-accent-blue hover:text-primary-light dark:hover:text-blue-400 transition-colors">
      AA
    </a>

    <!-- Navigation Desktop -->
    <ul class="hidden md:flex items-center gap-8">
      <li>
        <a href={`/${lang}#home`} class="text-text-dark dark:text-dark-text hover:text-primary dark:hover:text-accent-blue font-medium transition-colors">
          {navHome}
        </a>
      </li>
      <li>
        <a href={`/${lang}/projects`} class="text-text-dark dark:text-dark-text hover:text-primary dark:hover:text-accent-blue font-medium transition-colors">
          {navProjects}
        </a>
      </li>
      <li>
        <a href={`/${lang}#contact`} class="text-text-dark dark:text-dark-text hover:text-primary dark:hover:text-accent-blue font-medium transition-colors">
          {navContact}
        </a>
      </li>
      <li>
        <a href={`/${lang}/cam`} class="cam-link">
          <span class="cam-dot"></span>
          CAM
        </a>
      </li>
    </ul>

    <!-- Theme Toggle + Language Switcher + Menu Mobile -->
    <div class="flex items-center gap-3">
      <!-- ThemeToggle temporairement désactivé -->
      <!-- <ThemeToggle /> -->
      <LanguageSwitcher currentLang={lang} />
      
      <!-- Mobile Menu Button (optionnel) -->
      <button class="md:hidden p-2 hover:bg-gray-100 rounded-lg transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  .cam-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    background: rgba(139, 92, 246, 0.15);
    color: #a78bfa;
    border: 1px solid rgba(139, 92, 246, 0.3);
    transition: background 0.2s;
  }
  .cam-link:hover {
    background: rgba(139, 92, 246, 0.25);
  }
  .cam-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 6px #22c55e;
    display: inline-block;
    animation: cam-blink 1.4s ease-in-out infinite;
  }
  @keyframes cam-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
  }
</style>
