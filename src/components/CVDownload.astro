---
// src/components/CVDownload.astro
interface Props {
  translations: any;
  lang: 'en' | 'fr' | 'zh';
}

const { translations, lang } = Astro.props;

// Le fichier CV sera placé dans public/cv/
const cvFiles = {
  en: '/cv/Alexandre_Amedro_CV_EN.pdf',
  fr: '/cv/Alexandre_Amedro_CV_FR.pdf',
  zh: '/cv/Alexandre_Amedro_CV_ZH.pdf',
};

const cvFile = cvFiles[lang] || cvFiles.en;
---

<div class="flex justify-center">
  <a 
    href={cvFile}
    download
    class="group inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 dark:from-accent-blue dark:to-blue-500 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300"
  >
    <svg 
      class="w-6 h-6 group-hover:animate-bounce" 
      fill="none" 
      stroke="currentColor" 
      viewBox="0 0 24 24"
    >
      <path 
        stroke-linecap="round" 
        stroke-linejoin="round" 
        stroke-width="2" 
        d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
      />
    </svg>
    <span>{translations.cv.downloadPdf}</span>
  </a>
</div>

<style>
  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
</style>
