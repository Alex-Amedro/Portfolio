---
// src/components/EducationTimeline.astro
import type { Education } from '../data/education';

interface Props {
  education: Education[];
  lang: 'en' | 'fr' | 'zh';
  translations: any;
}

const { education, lang, translations } = Astro.props;

function formatDate(dateString: string | null, isCurrent: boolean) {
  if (dateString === null) return isCurrent ? translations.education.current : '';
  const [year, month] = dateString.split('-');
  return `${month}/${year}`;
}
---

<div class="space-y-8">
  {education.map((edu, index) => (
    <div class="relative pl-8 pb-8 border-l-2 border-blue-500 dark:border-accent-blue last:pb-0">
      <!-- Timeline dot -->
      <div class="absolute left-[-9px] top-0 w-4 h-4 rounded-full bg-blue-500 dark:bg-accent-blue border-4 border-white dark:border-dark-bg"></div>
      
      <!-- Content card -->
      <div class="bg-gray-50 dark:bg-dark-bg-secondary rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow duration-300">
        <div class="flex justify-between items-start mb-3">
          <div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-dark-text">
              {edu.school}
            </h3>
            <p class="text-lg text-blue-600 dark:text-accent-blue font-semibold">
              {edu.degree[lang]}
            </p>
            <p class="text-gray-600 dark:text-dark-text-secondary">
              {edu.field[lang]}
            </p>
          </div>
          
          <!-- Logo avec fond blanc -->
          {edu.logo && (
            <div class="bg-white dark:bg-white rounded-lg p-2 shadow-sm">
              <img 
                src={edu.logo} 
                alt={`${edu.school} logo`}
                class="w-16 h-16 object-contain"
              />
            </div>
          )}
        </div>
        
        <div class="flex items-center gap-4 mb-4 text-sm text-gray-500 dark:text-dark-text-secondary">
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            {edu.location}
          </div>
          
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            {formatDate(edu.startDate, false)} - {formatDate(edu.endDate, true) || translations.education.current}
          </div>
        </div>
        
        <p class="text-gray-700 dark:text-dark-text leading-relaxed">
          {edu.description[lang]}
        </p>
      </div>
    </div>
  ))}
</div>
