---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'zh' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as 'en' | 'fr' | 'zh';
---

<Layout title="CAM – Alexandre Amedro" description="Page CAM">
  <Header lang={currentLang} />

  <main class="pt-20 max-w-4xl mx-auto px-6 py-20">
    <h1 class="text-4xl font-bold text-text-dark dark:text-dark-text mb-6">CAM</h1>
    <p class="text-gray-600 dark:text-dark-text-secondary mb-10">Page temporaire · Examen CAM</p>

    <!-- Vidéo Google Drive – format vertical 9:16 -->
    <div class="mx-auto rounded-2xl overflow-hidden border border-gray-200 dark:border-slate-700 shadow-xl" style="max-width: 360px; aspect-ratio: 9/16;">
      <iframe
        src="https://drive.google.com/file/d/1c1K8Nbg7X2SxwE0ojpSCOmEmB0A5k5FN/preview"
        width="100%"
        height="100%"
        allow="autoplay"
        allowfullscreen
        style="border: none; display: block;"
      ></iframe>
    </div>
  </main>

  <Footer lang={currentLang} />
</Layout>
