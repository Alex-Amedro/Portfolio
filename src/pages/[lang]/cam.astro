---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'zh' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as 'en' | 'fr' | 'zh';
---

<Layout title="CAM – Alexandre Amedro" description="Page CAM">
  <Header lang={currentLang} />

  <main class="pt-20 max-w-4xl mx-auto px-6 py-20">
    <h1 class="text-4xl font-bold text-text-dark dark:text-dark-text mb-6">CAM</h1>
    <p class="text-gray-600 dark:text-dark-text-secondary mb-10">Page temporaire · Examen CAM</p>

    <!-- Placeholder vidéo -->
    <div class="w-full aspect-video bg-gray-100 dark:bg-dark-bg rounded-2xl flex items-center justify-center border border-gray-200 dark:border-slate-700">
      <p class="text-gray-400 dark:text-slate-500 text-sm">Vidéo à venir — colle ton lien ici</p>
    </div>
  </main>

  <Footer lang={currentLang} />
</Layout>
