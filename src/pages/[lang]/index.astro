---
// src/pages/[lang]/index.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getTranslation } from '../../data/translations';
import { getFeaturedProjects } from '../../data/projects';
import { skills } from '../../data/skills';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang } = Astro.params;

// Traductions
const heroTitle = getTranslation(lang || 'en', 'hero.title');
const heroSubtitle = getTranslation(lang || 'en', 'hero.subtitle');
const heroCta = getTranslation(lang || 'en', 'hero.cta');
const aboutTitle = getTranslation(lang || 'en', 'about.title');
const aboutDesc = getTranslation(lang || 'en', 'about.description');
const featuredTitle = getTranslation(lang || 'en', 'featured.title');
const viewAll = getTranslation(lang || 'en', 'featured.viewAll');
const contactTitle = getTranslation(lang || 'en', 'contact.title');
const contactDesc = getTranslation(lang || 'en', 'contact.description');

const featuredProjects = getFeaturedProjects();
const currentLang = lang || 'en';

// Fonction pour obtenir le titre traduit d'un projet
function getProjectTitle(project: any) {
  if (currentLang === 'fr') return project.titleFr;
  if (currentLang === 'zh') return project.titleZh;
  return project.titleEn;
}

function getProjectDescription(project: any) {
  if (currentLang === 'fr') return project.descriptionFr;
  if (currentLang === 'zh') return project.descriptionZh;
  return project.descriptionEn;
}
---

<Layout title="Alexandre Amedro | Multimedia Engineering Student" description="Master's student at ENSEEIHT specializing in Imaging and Multimedia">
  <Header lang={currentLang} />

  <main class="pt-20">
    <!-- Hero Section -->
    <section id="home" class="min-h-screen flex items-center justify-center px-6 py-20">
      <div class="text-center max-w-3xl data-animate">
        <h1 class="text-5xl md:text-7xl font-bold text-text-dark dark:text-dark-text mb-6 leading-tight">
          {heroTitle}
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 dark:text-dark-text-secondary mb-8 leading-relaxed">
          {heroSubtitle}
        </p>
        <a href={`/${currentLang}#projects`} class="btn btn-primary text-lg">
          {heroCta}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>
      </div>
    </section>

    <!-- About Section -->
    <section class="max-w-6xl mx-auto px-6 py-20 data-animate">
      <h2 class="text-4xl font-bold text-text-dark dark:text-dark-text mb-8">{aboutTitle}</h2>
      <p class="text-lg text-gray-600 dark:text-dark-text-secondary leading-relaxed mb-12 max-w-3xl">
        {aboutDesc}
      </p>
      
      <!-- Skills Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {
          skills.map((skill) => (
            <div class="bg-white dark:bg-dark-bg-secondary border border-gray-200 dark:border-slate-700 rounded-lg px-4 py-3 text-center hover:border-primary dark:hover:border-accent-blue hover:bg-primary/5 dark:hover:bg-accent-blue/10 transition-all duration-300">
              <p class="font-semibold text-text-dark dark:text-dark-text">{skill}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Featured Projects Section -->
    <section id="projects" class="max-w-6xl mx-auto px-6 py-20 data-animate">
      <h2 class="text-4xl font-bold text-text-dark dark:text-dark-text mb-12">{featuredTitle}</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        {
          featuredProjects.map((project) => (
            <ProjectCard
              title={getProjectTitle(project)}
              description={getProjectDescription(project)}
              image={project.image}
              stack={project.stack}
              slug={project.slug}
              status={project.status}
              lang={currentLang}
            />
          ))
        }
      </div>

      <!-- View All Button -->
      <div class="text-center">
        <a href={`/${currentLang}/projects`} class="btn btn-primary">
          {viewAll}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="max-w-4xl mx-auto px-6 py-20 data-animate">
      <h2 class="text-4xl font-bold text-text-dark dark:text-dark-text mb-6 text-center">{contactTitle}</h2>
      <p class="text-lg text-gray-600 dark:text-dark-text-secondary text-center mb-12 max-w-2xl mx-auto">
        {contactDesc}
      </p>

      <!-- Contact Form -->
      <form class="bg-white dark:bg-dark-bg-secondary border border-gray-200 dark:border-slate-700 rounded-xl p-8 mb-12 max-w-2xl mx-auto" id="contact-form">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <label for="name" class="block text-sm font-semibold text-text-dark dark:text-dark-text mb-2">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 bg-white dark:bg-dark-bg border border-gray-300 dark:border-slate-600 text-text-dark dark:text-dark-text rounded-lg focus:outline-none focus:border-primary dark:focus:border-accent-blue focus:ring-2 focus:ring-primary/10 dark:focus:ring-accent-blue/10 transition-all"
              placeholder="Your name"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-text-dark dark:text-dark-text mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 bg-white dark:bg-dark-bg border border-gray-300 dark:border-slate-600 text-text-dark dark:text-dark-text rounded-lg focus:outline-none focus:border-primary dark:focus:border-accent-blue focus:ring-2 focus:ring-primary/10 dark:focus:ring-accent-blue/10 transition-all"
              placeholder="your@email.com"
            />
          </div>
        </div>

        <div class="mb-6">
          <label for="message" class="block text-sm font-semibold text-text-dark dark:text-dark-text mb-2">Message</label>
          <textarea
            id="message"
            name="message"
            rows={6}
            required
            class="w-full px-4 py-3 bg-white dark:bg-dark-bg border border-gray-300 dark:border-slate-600 text-text-dark dark:text-dark-text rounded-lg focus:outline-none focus:border-primary dark:focus:border-accent-blue focus:ring-2 focus:ring-primary/10 dark:focus:ring-accent-blue/10 transition-all resize-none"
            placeholder="Your message here..."
          ></textarea>
        </div>

        <button type="submit" class="btn btn-primary w-full justify-center">
          Send Message
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>
      </form>

      <!-- Social Links -->
      <div class="flex justify-center gap-6">
        <a
          href="https://github.com/yourusername"
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center hover:bg-primary-light transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-1"
          title="GitHub"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
          </svg>
        </a>
        <a
          href="https://linkedin.com/in/yourusername"
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center hover:bg-primary-light transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-1"
          title="LinkedIn"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"></path>
          </svg>
        </a>
        <a
          href="mailto:hello@johndoe.com"
          class="w-12 h-12 bg-primary text-white rounded-lg flex items-center justify-center hover:bg-primary-light transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-1"
          title="Email"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </a>
      </div>
    </section>
  </main>

  <Footer lang={currentLang} />

  <script>
    // Contact form submission
    document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const formData = new FormData(form);

      // Exemple avec Formspree (à remplacer par votre service)
      try {
        const response = await fetch('https://formspree.io/f/YOUR_FORM_ID', {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
          },
        });

        if (response.ok) {
          alert('Message sent successfully!');
          form.reset();
        }
      } catch (error) {
        console.error('Error:', error);
        alert('There was an error sending your message. Please try again.');
      }
    });
  </script>
</Layout>
