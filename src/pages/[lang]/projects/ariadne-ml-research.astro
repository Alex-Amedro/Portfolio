---
// src/pages/[lang]/projects/ariadne-ml-research.astro
// PAGE PROJET RECHERCHE - Ariadne
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getTranslation } from '../../../data/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang } = Astro.params;
const currentLang = lang || 'en';

const viewOnGithub = getTranslation(currentLang, 'projects.viewOnGithub');

const heroTitles = {
  en: 'Ariadne - Adaptive Game Level Generation',
  fr: 'Ariadne - Génération Adaptative de Niveaux',
  zh: 'Ariadne项目 - 自适应关卡生成'
};

const heroPitches = {
  en: 'Guiding GAN latent space with RL to generate increasingly challenging Doom levels.',
  fr: 'Guider l\'espace latent d\'un GAN par RL pour générer des niveaux Doom progressivement plus difficiles.',
  zh: '使用RL引导GAN潜在空间，生成越来越具挑战性的Doom关卡。'
};

const researchContext = {
  en: '🎓 Research Context',
  fr: '🎓 Contexte de Recherche',
  zh: '🎓 研究背景'
};

const technicalApproach = {
  en: '🔬 Technical Approach',
  fr: '🔬 Approche Technique',
  zh: '🔬 技术方法'
};

const roadmap = {
  en: '🗺️ 2.5-Month Roadmap',
  fr: '🗺️ Feuille de Route (2.5 mois)',
  zh: '🗺️ 2.5个月路线图'
};

const futureWork = {
  en: 'Future Extensions',
  fr: 'Extensions Futures',
  zh: '未来扩展'
};
---

<Layout title={`${heroTitles[currentLang]} | Alexandre Amedro`}>
  <Header lang={currentLang} />

  <main class="pt-20">
    <!-- 🌟 HERO SECTION - Research Aesthetic -->
    <section class="relative bg-gradient-to-br from-indigo-900 via-purple-900 to-pink-900 text-white overflow-hidden">
      <!-- Neural network pattern background -->
      <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.1) 0%, transparent 50%), radial-gradient(circle at 80% 30%, rgba(255,255,255,0.1) 0%, transparent 50%);"></div>
      </div>
      
      <div class="relative max-w-7xl mx-auto px-6 py-20 md:py-32">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Left: Text -->
          <div class="space-y-6 data-animate">
            <!-- Top badges -->
            <div class="flex flex-wrap gap-3">
              <span class="px-4 py-1.5 bg-orange-500/20 border border-orange-500/50 rounded-lg text-orange-200 font-bold text-sm backdrop-blur">
                🔬 IN PROGRESS
              </span>
              <span class="px-4 py-1.5 bg-purple-500/20 border border-purple-500/50 rounded-lg text-purple-200 font-bold text-sm backdrop-blur">
                Oct 2025 - Jan 2026
              </span>
              <span class="px-4 py-1.5 bg-blue-500/20 border border-blue-500/50 rounded-lg text-blue-200 font-bold text-sm backdrop-blur">
                🎓 Research
              </span>
            </div>

            <!-- Title -->
            <h1 class="text-5xl md:text-6xl lg:text-7xl font-black leading-tight">
              
              {heroTitles[currentLang]}
            </h1>
            
            <p class="text-2xl md:text-3xl text-purple-200 font-bold">
              {heroPitches[currentLang]}
            </p>
            
            <p class="text-lg text-slate-200 leading-relaxed">
              {currentLang === 'fr' 
                ? 'Combinaison de Reinforcement Learning et GANs pour générer des niveaux Doom adaptatifs. Projet personnel de recherche.'
                : currentLang === 'zh'
                ? '结合强化学习和GAN生成自适应Doom关卡。个人研究项目。'
                : 'Combining Reinforcement Learning and GANs to generate adaptive Doom levels. Personal research project.'
              }
            </p>

            <!-- CTAs -->
            <div class="flex flex-wrap gap-4 pt-4">
              <a href="#approach" 
                 class="inline-flex items-center gap-3 px-8 py-4 bg-white text-purple-900 font-bold rounded-xl hover:bg-purple-50 transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-1">
                {currentLang === 'fr' ? 'Approche Technique' : currentLang === 'zh' ? '技术方法' : 'Technical Approach'}
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
              </a>
              
              <a href="#roadmap" 
                 class="inline-flex items-center gap-3 px-8 py-4 bg-transparent border-2 border-white text-white font-bold rounded-xl hover:bg-white/10 transition-all duration-300">
                {currentLang === 'fr' ? 'Voir la Roadmap' : currentLang === 'zh' ? '查看路线图' : 'View Roadmap'}
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>

            <!-- Institution Badge -->
            <div class="flex items-center gap-6 text-sm text-purple-200 pt-4">
              <div class="flex items-center gap-2">
                <span class="text-xl">🏛️</span>
                <span class="font-semibold">NCKU Taiwan</span>
              </div>
              <div class="w-px h-6 bg-purple-400/30"></div>
              <div class="flex items-center gap-2">
                <span class="text-xl">🎓</span>
                <span class="font-semibold">ENSEEIHT</span>
              </div>
            </div>
          </div>
          
          <!-- Right: Doom Image -->
          <div class="relative data-animate">
            <div class="relative rounded-2xl overflow-hidden shadow-2xl border-4 border-white/20 backdrop-blur">
              <img src="/projects/ariadne/doom.jpeg" alt="Doom Level Generation" class="w-full h-auto" />
              
              
            </div>
            
            <!-- Floating stat cards -->
            <div class="absolute -bottom-6 -left-6 bg-white text-slate-900 px-6 py-4 rounded-xl shadow-xl border-2 border-purple-500">
              <div class="text-3xl font-black text-purple-600">RL + GAN</div>
              <div class="text-sm font-semibold text-slate-600">Hybrid Approach</div>
            </div>
            
            <div class="absolute -top-6 -right-6 bg-white text-slate-900 px-6 py-4 rounded-xl shadow-xl border-2 border-pink-500">
              <div class="text-3xl font-black text-pink-600">ARMS RACE</div>
              <div class="text-sm font-semibold text-slate-600">co-evolution AI</div>
            </div>
          </div>
        </div>

        
      </div>
    </section>

    <!-- 🎓 RESEARCH CONTEXT -->
    <section class="bg-white dark:bg-slate-900 py-20">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white mb-16 text-center data-animate">
          {researchContext[currentLang]}
        </h2>
      
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Problem -->
        <div class="bg-gradient-to-br from-red-50 to-orange-50 dark:from-red-900/20 dark:to-orange-900/20 p-8 rounded-2xl border-2 border-red-200 dark:border-red-700 data-animate">
          <div class="text-5xl mb-4">❌</div>
          <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">
            {currentLang === 'fr' ? 'Le Problème' : currentLang === 'zh' ? '问题' : 'The Problem'}
          </h3>
          <p class="text-slate-600 dark:text-slate-300">
            {currentLang === 'fr' 
              ? 'Générer des niveaux de jeu qui s\'adaptent automatiquement à la compétence du joueur est difficile. Les approches traditionnelles échouent face à la complexité.'
              : currentLang === 'zh'
              ? '生成自动适应玩家技能的游戏关卡很困难。传统方法在复杂性面前失败。'
              : 'Generating game levels that automatically adapt to player skill is hard. Traditional approaches fail against complexity.'
            }
          </p>
        </div>

        <!-- Approach -->
        <div class="bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20 p-8 rounded-2xl border-2 border-blue-200 dark:border-blue-700 data-animate">
          <div class="text-5xl mb-4">💡</div>
          <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">
            {currentLang === 'fr' ? 'Notre Approche' : currentLang === 'zh' ? '我们的方法' : 'Our Approach'}
          </h3>
          <p class="text-slate-600 dark:text-slate-300">
            {currentLang === 'fr' 
              ? 'Utiliser un agent RL pour explorer l\'espace latent d\'un GAN pré-entraîné. Le RL trouve les "bons" vecteurs latents qui génèrent des niveaux intéressants.'
              : currentLang === 'zh'
              ? '使用RL代理探索预训练GAN的潜在空间。RL找到生成有趣关卡的"好"潜在向量。'
              : 'Use an RL agent to explore the latent space of a pre-trained GAN. RL finds the "good" latent vectors that generate interesting levels.'
            }
          </p>
        </div>

        <!-- Impact -->
        <div class="bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 p-8 rounded-2xl border-2 border-green-200 dark:border-green-700 data-animate">
          <div class="text-5xl mb-4">🎯</div>
          <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">
            {currentLang === 'fr' ? 'Impact Attendu' : currentLang === 'zh' ? '预期影响' : 'Expected Impact'}
          </h3>
          <p class="text-slate-600 dark:text-slate-300">
            {currentLang === 'fr' 
              ? 'Créer un système qui génère automatiquement des niveaux de plus en plus difficiles, maintenant l\'engagement du joueur dans un état de "flow".'
              : currentLang === 'zh'
              ? '创建一个自动生成越来越困难关卡的系统，使玩家保持在"心流"状态。'
              : 'Create a system that automatically generates progressively harder levels, keeping the player in a "flow" state.'
            }
          </p>
        </div>
      </div>
    </section>

    <!-- 🔬 TECHNICAL APPROACH -->
    <section id="approach" class="bg-gradient-to-br from-slate-900 to-purple-900 text-white py-20">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-4xl md:text-5xl font-black text-center mb-16 data-animate">
          {technicalApproach[currentLang]}
        </h2>
        
        <div class="grid md:grid-cols-2 gap-12">
          <!-- Pillar 1: RL Player -->
          <div class="bg-white/10 backdrop-blur border-2 border-blue-500/30 p-8 rounded-2xl hover:border-blue-500 transition-all data-animate">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-16 h-16 bg-blue-500 rounded-2xl flex items-center justify-center text-3xl">
                🎮
              </div>
              <div>
                <h3 class="text-2xl font-bold text-blue-300">
                  {currentLang === 'fr' ? 'Pilier 1 : Joueur RL' : currentLang === 'zh' ? '支柱1：RL玩家' : 'Pillar 1: RL Player'}
                </h3>
                <p class="text-sm text-blue-200">{currentLang === 'fr' ? 'L\'Évaluateur' : currentLang === 'zh' ? '评估器' : 'The Evaluator'}</p>
              </div>
            </div>
            
            <ul class="space-y-3 text-white/90">
              <li class="flex items-start gap-2">
                <span class="text-blue-400 font-bold">•</span>
                <span><strong>Algorithm:</strong> DQN or PPO {currentLang === 'fr' ? '(pré-entraîné)' : currentLang === 'zh' ? '（预训练）' : '(pre-trained)'}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-blue-400 font-bold">•</span>
                <span><strong>Role:</strong> {currentLang === 'fr' ? 'Jouer sur un niveau WAD et retourner un score (fitness)' : currentLang === 'zh' ? '玩WAD关卡并返回分数（适应度）' : 'Play a WAD level and return a score (fitness)'}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-blue-400 font-bold">•</span>
                <span><strong>Environment:</strong> ViZDoom (Doom 1993)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-blue-400 font-bold">•</span>
                <span><strong>Output:</strong> {currentLang === 'fr' ? 'Score de difficulté/qualité' : currentLang === 'zh' ? '难度/质量分数' : 'Difficulty/quality score'}</span>
              </li>
            </ul>

            <div class="mt-6 p-4 bg-slate-900 rounded-xl font-mono text-sm text-green-400">
              <code>evaluate_agent.py → fitness_score</code>
            </div>
          </div>

          <!-- Pillar 2: GAN Architect -->
          <div class="bg-white/10 backdrop-blur border-2 border-pink-500/30 p-8 rounded-2xl hover:border-pink-500 transition-all data-animate">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-16 h-16 bg-pink-500 rounded-2xl flex items-center justify-center text-3xl">
                🎨
              </div>
              <div>
                <h3 class="text-2xl font-bold text-pink-300">
                  {currentLang === 'fr' ? 'Pilier 2 : Architecte GAN' : currentLang === 'zh' ? '支柱2：GAN架构师' : 'Pillar 2: GAN Architect'}
                </h3>
                <p class="text-sm text-pink-200">{currentLang === 'fr' ? 'Le Créateur' : currentLang === 'zh' ? '创造者' : 'The Creator'}</p>
              </div>
            </div>
            
            <ul class="space-y-3 text-white/90">
              <li class="flex items-start gap-2">
                <span class="text-pink-400 font-bold">•</span>
                <span><strong>Model:</strong> {currentLang === 'fr' ? 'GAN pré-entraîné (gelé)' : currentLang === 'zh' ? '预训练GAN（冻结）' : 'Pre-trained GAN (frozen)'}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-pink-400 font-bold">•</span>
                <span><strong>Input:</strong> {currentLang === 'fr' ? 'Vecteur latent z ∈ ℝⁿ' : currentLang === 'zh' ? '潜在向量 z ∈ ℝⁿ' : 'Latent vector z ∈ ℝⁿ'}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-pink-400 font-bold">•</span>
                <span><strong>Output:</strong> {currentLang === 'fr' ? 'Fichier .WAD (niveau Doom jouable)' : currentLang === 'zh' ? '.WAD文件（可玩的Doom关卡）' : '.WAD file (playable Doom level)'}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-pink-400 font-bold">•</span>
                <span><strong>Framework:</strong> PyTorch</span>
              </li>
            </ul>

            <div class="mt-6 p-4 bg-slate-900 rounded-xl font-mono text-sm text-green-400">
              <code>generate_level.py → level.wad</code>
            </div>
          </div>
        </div>

        <!-- The Steering Mechanism -->
        <div class="mt-12 bg-gradient-to-r from-purple-500/20 to-pink-500/20 backdrop-blur border-2 border-purple-400 p-8 rounded-2xl data-animate">
          <h3 class="text-3xl font-bold text-purple-200 mb-8 flex items-center gap-3">
            <span class="text-3xl">🎯</span>
            {currentLang === 'fr' ? 'Le Mécanisme de Guidage' : currentLang === 'zh' ? '引导机制' : 'The Steering Mechanism'}
          </h3>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-white/10 backdrop-blur p-6 rounded-xl border border-purple-400/30">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 bg-purple-500 rounded-lg flex items-center justify-center text-white font-black text-xl">1</div>
                <div class="font-bold text-xl text-white">{currentLang === 'fr' ? 'Échantillonner' : currentLang === 'zh' ? '采样' : 'Sample'}</div>
              </div>
              <p class="text-purple-200 leading-relaxed">{currentLang === 'fr' ? 'Générer N vecteurs latents aléatoires dans l\'espace du GAN' : currentLang === 'zh' ? '在GAN空间中生成N个随机潜在向量' : 'Generate N random latent vectors in GAN space'}</p>
            </div>
            <div class="bg-white/10 backdrop-blur p-6 rounded-xl border border-pink-400/30">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 bg-pink-500 rounded-lg flex items-center justify-center text-white font-black text-xl">2</div>
                <div class="font-bold text-xl text-white">{currentLang === 'fr' ? 'Évaluer' : currentLang === 'zh' ? '评估' : 'Evaluate'}</div>
              </div>
              <p class="text-pink-200 leading-relaxed">{currentLang === 'fr' ? 'Le joueur RL teste et score chaque niveau généré' : currentLang === 'zh' ? 'RL玩家测试并为每个生成的关卡评分' : 'RL player tests and scores each generated level'}</p>
            </div>
            <div class="bg-white/10 backdrop-blur p-6 rounded-xl border border-blue-400/30">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center text-white font-black text-xl">3</div>
                <div class="font-bold text-xl text-white">{currentLang === 'fr' ? 'Optimiser' : currentLang === 'zh' ? '优化' : 'Optimize'}</div>
              </div>
              <p class="text-blue-200 leading-relaxed">{currentLang === 'fr' ? 'Cross-Entropy Method affine la recherche vers les meilleurs vecteurs' : currentLang === 'zh' ? '交叉熵方法将搜索细化到最佳向量' : 'Cross-Entropy Method refines search toward best vectors'}</p>
            </div>
          </div>
          <div class="mt-8 text-center">
            <div class="inline-flex items-center gap-3 px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 rounded-full text-white font-bold text-lg">
              
              <span>{currentLang === 'fr' ? 'Répéter jusqu\'à convergence' : currentLang === 'zh' ? '重复直至收敛' : 'Repeat until convergence'}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 🗺️ ROADMAP -->
    <section id="roadmap" class="max-w-7xl mx-auto px-6 py-20">
      <h2 class="text-4xl font-black text-slate-900 dark:text-white mb-12 text-center data-animate">
        {roadmap[currentLang]}
      </h2>
      
      <div class="space-y-8">
        <!-- Phase 1 -->
        <div class="group bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-lg border-l-4 border-blue-500 hover:shadow-xl transition-all data-animate">
          <div class="flex items-start gap-6">
            <div class="flex-shrink-0">
              <div class="w-16 h-16 bg-blue-500 rounded-2xl flex items-center justify-center text-white font-black text-2xl">
                1
              </div>
            </div>
            <div class="flex-1">
              <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">
                {currentLang === 'fr' ? 'Phase 1 : Fondations (Théorie & Outils)' : currentLang === 'zh' ? '阶段1：基础（理论与工具）' : 'Phase 1: Foundations (Theory & Tools)'}
              </h3>
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <p class="font-semibold text-blue-600 dark:text-blue-400 mb-2">RL Setup</p>
                  <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1">
                    <li>• {currentLang === 'fr' ? 'Installer ViZDoom' : currentLang === 'zh' ? '安装ViZDoom' : 'Install ViZDoom'}</li>
                    <li>• {currentLang === 'fr' ? 'Comprendre la boucle RL' : currentLang === 'zh' ? '理解RL循环' : 'Understand RL loop'}</li>
                    <li>• {currentLang === 'fr' ? 'Décortiquer learning_pytorch.py' : currentLang === 'zh' ? '分析learning_pytorch.py' : 'Analyze learning_pytorch.py'}</li>
                  </ul>
                </div>
                <div>
                  <p class="font-semibold text-pink-600 dark:text-pink-400 mb-2">GAN Setup</p>
                  <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1">
                    <li>• {currentLang === 'fr' ? 'Trouver GAN pré-entraîné' : currentLang === 'zh' ? '找到预训练GAN' : 'Find pre-trained GAN'}</li>
                    <li>• {currentLang === 'fr' ? 'Tester génération WAD' : currentLang === 'zh' ? '测试WAD生成' : 'Test WAD generation'}</li>
                    <li>• {currentLang === 'fr' ? 'Valider niveaux jouables' : currentLang === 'zh' ? '验证可玩关卡' : 'Validate playable levels'}</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Phase 2 -->
        <div class="group bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-lg border-l-4 border-green-500 hover:shadow-xl transition-all data-animate">
          <div class="flex items-start gap-6">
            <div class="flex-shrink-0">
              <div class="w-16 h-16 bg-green-500 rounded-2xl flex items-center justify-center text-white font-black text-2xl">
                2
              </div>
            </div>
            <div class="flex-1">
              <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">
                {currentLang === 'fr' ? 'Phase 2 : Construction des Piliers' : currentLang === 'zh' ? '阶段2：构建支柱' : 'Phase 2: Building Pillars'}
              </h3>
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <p class="font-semibold text-blue-600 dark:text-blue-400 mb-2">RL Player</p>
                  <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1">
                    <li>• {currentLang === 'fr' ? 'Entraîner agent compétent' : currentLang === 'zh' ? '训练称职的代理' : 'Train competent agent'}</li>
                    <li>• {currentLang === 'fr' ? 'Script evaluate_agent.py' : currentLang === 'zh' ? '脚本evaluate_agent.py' : 'Script evaluate_agent.py'}</li>
                    <li>• <strong>{currentLang === 'fr' ? 'Livrable: Fonction fitness' : currentLang === 'zh' ? '交付物：适应度函数' : 'Deliverable: Fitness function'}</strong></li>
                  </ul>
                </div>
                <div>
                  <p class="font-semibold text-pink-600 dark:text-pink-400 mb-2">GAN Architect</p>
                  <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1">
                    <li>• {currentLang === 'fr' ? 'Pipeline génération' : currentLang === 'zh' ? '生成管道' : 'Generation pipeline'}</li>
                    <li>• {currentLang === 'fr' ? 'Script generate_level.py' : currentLang === 'zh' ? '脚本generate_level.py' : 'Script generate_level.py'}</li>
                    <li>• <strong>{currentLang === 'fr' ? 'Livrable: z → WAD' : currentLang === 'zh' ? '交付物：z → WAD' : 'Deliverable: z → WAD'}</strong></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Phase 3 -->
        <div class="group bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-lg border-l-4 border-purple-500 hover:shadow-xl transition-all data-animate">
          <div class="flex items-start gap-6">
            <div class="flex-shrink-0">
              <div class="w-16 h-16 bg-purple-500 rounded-2xl flex items-center justify-center text-white font-black text-2xl">
                3
              </div>
            </div>
            <div class="flex-1">
