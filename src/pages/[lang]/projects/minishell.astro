---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getProjectBySlug } from '../../../data/projects';

export function getStaticPaths() {
  return [
    { params: { lang: 'en', slug: 'minishell' } },
    { params: { lang: 'fr', slug: 'minishell' } },
    { params: { lang: 'zh', slug: 'minishell' } }
  ];
}

const { lang, slug } = Astro.params;
const currentLang = (lang || 'en') as 'en' | 'fr' | 'zh';
const project = getProjectBySlug('minishell');

if (!project) {
  return Astro.redirect(`/${lang}/projects`);
}

const t = {
  en: {
    challenge: 'Technical Challenges',
    solution: 'Solution',
    learnings: 'What I Learned',
    stack: 'Tech Stack',
    viewCode: 'View Code',
    backToProjects: 'Back to Projects',
  },
  fr: {
    challenge: 'Défis Techniques',
    solution: 'Solution',
    learnings: 'Ce que j\'ai Appris',
    stack: 'Stack Technique',
    viewCode: 'Voir le Code',
    backToProjects: 'Retour aux Projets',
  },
  zh: {
    challenge: '技术挑战',
    solution: '解决方案',
    learnings: '学到的知识',
    stack: '技术栈',
    viewCode: '查看代码',
    backToProjects: '返回项目',
  }
};

const translations = t[currentLang];
const getTitle = () => currentLang === 'fr' ? project.titleFr : currentLang === 'zh' ? project.titleZh : project.titleEn;
const getDescription = () => currentLang === 'fr' ? project.descriptionFr : currentLang === 'zh' ? project.descriptionZh : project.descriptionEn;
const getChallenge = () => currentLang === 'fr' ? project.challengeFr : currentLang === 'zh' ? project.challengeZh : project.challengeEn;
const getSolution = () => currentLang === 'fr' ? project.solutionFr : currentLang === 'zh' ? project.solutionZh : project.solutionEn;
const getLearnings = () => currentLang === 'fr' ? project.learningsFr : currentLang === 'zh' ? project.learningsZh : project.learningsEn;
---

<Layout title={`${getTitle()} | Alexandre Amedro`} description={getDescription()}>
  <Header lang={currentLang} />

  <main class="pt-20">
    <!-- Hero Section -->
    <section class="max-w-5xl mx-auto px-6 py-20">
      <a href={`/${currentLang}/projects`} class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:underline mb-8">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        {translations.backToProjects}
      </a>

      <h1 class="text-5xl md:text-6xl font-bold text-text-dark dark:text-dark-text mb-4 data-animate">
        {getTitle()}
      </h1>
      <p class="text-xl text-gray-600 dark:text-dark-text-secondary mb-8 data-animate">
        {getDescription()}
      </p>

      <!-- Meta Info -->
      <div class="flex flex-wrap gap-6 mb-12 data-animate">
        <div>
          <span class="text-sm text-gray-600 dark:text-dark-text-secondary">Status</span>
          <p class="text-lg font-semibold text-text-dark dark:text-dark-text">
            {project.status === 'completed' ? 'Completed' : 'In Progress'}
          </p>
        </div>
        <div>
          <span class="text-sm text-gray-600 dark:text-dark-text-secondary">Date</span>
          <p class="text-lg font-semibold text-text-dark dark:text-dark-text">{project.date}</p>
        </div>
      </div>

      <!-- Tech Stack -->
      <div class="mb-12 data-animate">
        <h3 class="text-lg font-bold text-text-dark dark:text-dark-text mb-4">{translations.stack}</h3>
        <div class="flex flex-wrap gap-3">
          {project.stack.map((tech) => (
            <span class="px-4 py-2 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full text-sm font-semibold">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <!-- CTA -->
      {project.githubUrl && (
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 btn btn-primary text-lg data-animate">
          {translations.viewCode}
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
          </svg>
        </a>
      )}
    </section>

    <!-- Challenges Section -->
    <section class="max-w-5xl mx-auto px-6 py-20 border-t border-gray-200 dark:border-gray-700">
      <h2 class="text-4xl font-bold text-text-dark dark:text-dark-text mb-12 data-animate">
        {translations.challenge}
      </h2>
      <div class="prose dark:prose-invert max-w-none data-animate">
        <div class="text-gray-700 dark:text-gray-300 whitespace-pre-wrap">
          {getChallenge()}
        </div>
      </div>
    </section>

    <!-- Solution Section -->
    <section class="max-w-5xl mx-auto px-6 py-20 border-t border-gray-200 dark:border-gray-700">
      <h2 class="text-4xl font-bold text-text-dark dark:text-dark-text mb-12 data-animate">
        {translations.solution}
      </h2>
      <div class="prose dark:prose-invert max-w-none data-animate">
        <div class="text-gray-700 dark:text-gray-300 whitespace-pre-wrap">
          {getSolution()}
        </div>
      </div>
    </section>

    <!-- Learnings Section -->
    <section class="max-w-5xl mx-auto px-6 py-20 border-t border-gray-200 dark:border-gray-700">
      <h2 class="text-4xl font-bold text-text-dark dark:text-dark-text mb-12 data-animate">
        {translations.learnings}
      </h2>
      <div class="prose dark:prose-invert max-w-none data-animate">
        <div class="text-gray-700 dark:text-gray-300 whitespace-pre-wrap">
          {getLearnings()}
        </div>
      </div>
    </section>
  </main>

  <Footer lang={currentLang} />
</Layout>
