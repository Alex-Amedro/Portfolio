---
// src/pages/[lang]/projects/drone-speedrunner-rl.astro
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getTranslation } from '../../../data/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as 'en' | 'fr' | 'zh';

const t = (key: string) => getTranslation(currentLang, key);

const heroTitles = {
  en: 'Drone Speedrunner',
  fr: 'Drone Speedrunner',
  zh: '无人机极速跑者',
};

const heroSubtitles = {
  en: 'RL Obstacle Avoidance',
  fr: 'Évitement d\'Obstacles par RL',
  zh: '强化学习避障',
};

const heroPitches = {
  en: 'A quadrotor learns to fly at ~12 m/s through an infinite tree corridor — no map, no trajectory, only a 2D LiDAR.',
  fr: 'Un quadrirotor apprend à voler à ~12 m/s dans un couloir d\'arbres infini — sans carte, sans trajectoire, seulement un LiDAR 2D.',
  zh: '四旋翼无人机学习以约12m/s穿越无限树木走廊——无地图、无轨迹、仅凭2D LiDAR。',
};
---

<Layout title={`${heroTitles[currentLang]} | Alexandre Amedro`} description={heroPitches[currentLang]}>
  <Header lang={currentLang} />

  <main class="pt-20">

    <!-- ═══════════════════════════════════════
         HERO
    ═══════════════════════════════════════ -->
    <section class="relative bg-gradient-to-br from-slate-950 via-cyan-950 to-teal-900 text-white overflow-hidden min-h-[90vh] flex items-center">
      <!-- Animated grid bg -->
      <div class="absolute inset-0 opacity-10" aria-hidden="true">
        <div class="absolute inset-0" style="background-image: linear-gradient(rgba(20,184,166,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(20,184,166,0.3) 1px, transparent 1px); background-size: 60px 60px;"></div>
      </div>
      <!-- Radial glow -->
      <div class="absolute top-1/4 left-1/3 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-teal-400/8 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative max-w-7xl mx-auto px-6 py-24 md:py-32 w-full">
        <div class="grid md:grid-cols-2 gap-14 items-center">

          <!-- Left: text -->
          <div class="space-y-8 data-animate">
            <!-- Badges -->
            <div class="flex flex-wrap gap-3">
              <span class="px-4 py-1.5 bg-teal-500/20 border border-teal-500/50 rounded-lg text-teal-200 font-bold text-sm backdrop-blur-sm">
                🤖 Reinforcement Learning
              </span>
              <span class="px-4 py-1.5 bg-orange-500/20 border border-orange-500/50 rounded-lg text-orange-200 font-bold text-sm backdrop-blur-sm">
                🔬 {currentLang === 'fr' ? 'En cours' : currentLang === 'zh' ? '进行中' : 'In Progress'}
              </span>
            </div>

            <div>
              <h1 class="text-6xl md:text-7xl lg:text-8xl font-black leading-none tracking-tight">
                {heroTitles[currentLang]}
              </h1>
              <p class="text-2xl md:text-3xl font-bold text-cyan-300 mt-3">
                {heroSubtitles[currentLang]}
              </p>
            </div>

            <p class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-xl">
              {heroPitches[currentLang]}
            </p>

            <!-- Key number -->
            <div class="flex flex-wrap gap-6">
              <div class="bg-white/5 border border-cyan-500/30 rounded-2xl px-6 py-4 backdrop-blur-sm">
                <div class="text-4xl font-black text-cyan-300">~12 m/s</div>
                <div class="text-xs text-slate-400 font-semibold uppercase tracking-wider mt-1">
                  {currentLang === 'fr' ? 'Vitesse de vol' : currentLang === 'zh' ? '飞行速度' : 'Flight speed'}
                </div>
              </div>
              <div class="bg-white/5 border border-teal-500/30 rounded-2xl px-6 py-4 backdrop-blur-sm">
                <div class="text-4xl font-black text-teal-300">486 m</div>
                <div class="text-xs text-slate-400 font-semibold uppercase tracking-wider mt-1">
                  {currentLang === 'fr' ? 'Meilleure distance (obstacles)' : currentLang === 'zh' ? '最佳有障碍距离' : 'Best distance (obstacles)'}
                </div>
              </div>
              <div class="bg-white/5 border border-emerald-500/30 rounded-2xl px-6 py-4 backdrop-blur-sm">
                <div class="text-4xl font-black text-emerald-300">1.7×</div>
                <div class="text-xs text-slate-400 font-semibold uppercase tracking-wider mt-1">
                  {currentLang === 'fr' ? 'Au-delà de l\'entraînement' : currentLang === 'zh' ? '超越训练距离' : 'Beyond training dist.'}
                </div>
              </div>
            </div>

            <!-- CTAs -->
            <div class="flex flex-wrap gap-4 pt-2">
              <a href="#results"
                 class="inline-flex items-center gap-3 px-8 py-4 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold rounded-xl transition-all duration-300 shadow-lg shadow-cyan-500/30 hover:shadow-cyan-400/40 hover:-translate-y-1">
                {currentLang === 'fr' ? 'Voir les résultats' : currentLang === 'zh' ? '查看结果' : 'See Results'}
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
              </a>
              <a href="#perception"
                 class="inline-flex items-center gap-3 px-8 py-4 bg-white/5 border-2 border-white/20 text-white font-bold rounded-xl hover:bg-white/10 hover:border-cyan-400/50 transition-all duration-300 backdrop-blur-sm">
                {currentLang === 'fr' ? 'Approche technique' : currentLang === 'zh' ? '技术方法' : 'Technical Approach'}
              </a>
            </div>
          </div>

          <!-- Right: visual placeholder / media zone -->
          <div class="relative data-animate" aria-label="Project visuals">
            <!-- Main clip placeholder -->
            <div class="relative rounded-2xl overflow-hidden border-2 border-cyan-500/30 bg-slate-900/80 backdrop-blur-sm shadow-2xl shadow-cyan-900/40 aspect-video flex items-center justify-center group">
              <!-- If cover.jpg exists it will display; otherwise shows placeholder -->
              <img
                src="/projects/drone-speedrunner/cover.jpg"
                alt="Drone flying through obstacle forest"
                class="w-full h-full object-cover"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div class="absolute inset-0 flex-col items-center justify-center gap-4 text-slate-400 text-center p-8 hidden">
                <svg class="w-20 h-20 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 10l4.553-2.069A1 1 0 0121 8.868V15.5M3 8l9 5 9-5M3 8v8l9 5 9-5V8"></path>
                </svg>
                <p class="text-sm opacity-50">{currentLang === 'fr' ? 'Clips vidéo à venir' : currentLang === 'zh' ? '视频片段即将上传' : 'Video clips coming soon'}</p>
              </div>
              <!-- Corner glow -->
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent pointer-events-none"></div>
            </div>

            <!-- Floating stat cards -->
            <div class="absolute -bottom-5 -left-5 bg-slate-900 border-2 border-cyan-500 px-5 py-3 rounded-xl shadow-xl shadow-cyan-900/40">
              <div class="text-2xl font-black text-cyan-400">SAC</div>
              <div class="text-xs text-slate-400 font-semibold">Soft Actor-Critic</div>
            </div>
            <div class="absolute -top-5 -right-5 bg-slate-900 border-2 border-teal-500 px-5 py-3 rounded-xl shadow-xl shadow-teal-900/40">
              <div class="text-2xl font-black text-teal-400">∞ Runner</div>
              <div class="text-xs text-slate-400 font-semibold">{currentLang === 'fr' ? 'Couloir infini' : currentLang === 'zh' ? '无限走廊' : 'Infinite corridor'}</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         RESULTS
    ═══════════════════════════════════════ -->
    <section id="results" class="bg-slate-950 text-white py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-4xl md:text-5xl font-black text-center mb-4 data-animate">
          {currentLang === 'fr' ? '📊 Résultats' : currentLang === 'zh' ? '📊 结果' : '📊 Results'}
        </h2>
        <p class="text-center text-slate-400 mb-16 data-animate">
          {currentLang === 'fr' ? 'Modèle final · 30 épisodes par configuration' : currentLang === 'zh' ? '最终模型 · 每配置30集' : 'Final model · 30 episodes per configuration'}
        </p>

        <!-- Stat cards row -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16 data-animate">
          {[
            { label: currentLang === 'fr' ? 'Couloir vide' : currentLang === 'zh' ? '空走廊' : 'Empty corridor', value: '100%', sub: '300m / 500m / 1000m', color: 'emerald' },
            { label: currentLang === 'fr' ? 'Densité faible' : currentLang === 'zh' ? '低密度' : 'Low density', value: '96.7%', sub: '100m track', color: 'teal' },
            { label: currentLang === 'fr' ? 'Densité moyenne' : currentLang === 'zh' ? '中密度' : 'Medium density', value: '90%', sub: '150m track', color: 'cyan' },
            { label: currentLang === 'fr' ? 'Densité élevée' : currentLang === 'zh' ? '高密度' : 'Dense', value: '75%', sub: '50m track', color: 'yellow' },
          ].map(s => (
            <div class={`bg-slate-900 border border-${s.color}-500/30 rounded-2xl p-6 text-center hover:border-${s.color}-500/60 transition-colors`}>
              <div class={`text-4xl md:text-5xl font-black text-${s.color}-400 mb-2`}>{s.value}</div>
              <div class="text-sm font-bold text-white mb-1">{s.label}</div>
              <div class="text-xs text-slate-500">{s.sub}</div>
            </div>
          ))}
        </div>

        <!-- Results table -->
        <div class="bg-slate-900 rounded-2xl border border-slate-700 overflow-hidden data-animate">
          <div class="px-6 py-4 border-b border-slate-700 bg-slate-800/50">
            <h3 class="font-bold text-slate-200">
              {currentLang === 'fr' ? 'Taux de réussite par configuration' : currentLang === 'zh' ? '各配置成功率' : 'Success rate by configuration'}
            </h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-slate-700/60">
                  <th class="text-left px-6 py-3 text-slate-400 font-semibold">
                    {currentLang === 'fr' ? 'Densité d\'obstacles' : currentLang === 'zh' ? '障碍物密度' : 'Obstacle density'}
                  </th>
                  <th class="text-center px-4 py-3 text-slate-400 font-semibold">50 m</th>
                  <th class="text-center px-4 py-3 text-slate-400 font-semibold">100 m</th>
                  <th class="text-center px-4 py-3 text-slate-400 font-semibold">150 m</th>
                </tr>
              </thead>
              <tbody>
                {[
                  { density: currentLang === 'fr' ? 'Vide' : currentLang === 'zh' ? '空' : 'Empty', v50: '100%', v100: '—', v150: '—', highlight: true },
                  { density: currentLang === 'fr' ? 'Faible' : currentLang === 'zh' ? '低' : 'Low', v50: '95%', v100: '96.7%', v150: '90%', highlight: false },
                  { density: currentLang === 'fr' ? 'Moyenne' : currentLang === 'zh' ? '中' : 'Medium', v50: '95%', v100: '80%', v150: '90%', highlight: false },
                  { density: currentLang === 'fr' ? 'Dense' : currentLang === 'zh' ? '高' : 'Dense', v50: '75%', v100: '—', v150: '—', highlight: false },
                ].map((row, i) => (
                  <tr class={`border-b border-slate-800 ${i % 2 === 0 ? 'bg-slate-900' : 'bg-slate-900/50'} hover:bg-slate-800/50 transition-colors`}>
                    <td class="px-6 py-4 font-semibold text-slate-200">{row.density}</td>
                    <td class="text-center px-4 py-4 text-emerald-400 font-bold">{row.v50}</td>
                    <td class="text-center px-4 py-4 text-cyan-400 font-bold">{row.v100}</td>
                    <td class="text-center px-4 py-4 text-teal-400 font-bold">{row.v150}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Headline result -->
        <div class="mt-10 bg-gradient-to-r from-cyan-950 to-teal-950 border-2 border-cyan-500/40 rounded-2xl p-8 data-animate">
          <div class="flex flex-col md:flex-row items-center gap-6">
            <div class="text-6xl font-black text-cyan-400 shrink-0">486 m</div>
            <div>
              <p class="text-white font-bold text-xl mb-1">
                {currentLang === 'fr'
                  ? 'Parcourus sur une piste de 500 m avec obstacles'
                  : currentLang === 'zh'
                  ? '在有障碍物的500m赛道上行驶'
                  : 'Covered on a 500m track with obstacles'}
              </p>
              <p class="text-slate-300 leading-relaxed">
                {currentLang === 'fr'
                  ? '1,7× plus loin que la plus longue piste jamais vue pendant l\'entraînement (limité à 300 m). Le modèle généralise au-delà de ce qu\'il a appris.'
                  : currentLang === 'zh'
                  ? '比训练期间见过的最长赛道（限300m）远1.7倍。模型能够泛化到超出训练范围的场景。'
                  : '1.7× farther than the longest track ever seen during training (capped at 300m). The model generalizes beyond what it learned.'}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         PERCEPTION — LiDAR FOVÉAL
    ═══════════════════════════════════════ -->
    <section id="perception" class="bg-gradient-to-br from-slate-900 to-cyan-950 text-white py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-4xl md:text-5xl font-black text-center mb-4 data-animate">
          {currentLang === 'fr' ? '🔭 Le Problème de Perception' : currentLang === 'zh' ? '🔭 感知问题' : '🔭 The Perception Problem'}
        </h2>
        <p class="text-center text-cyan-300/70 mb-16 text-lg data-animate">
          {currentLang === 'fr' ? 'Résolu par le calcul, pas par tâtonnement' : currentLang === 'zh' ? '用数学解决，而非试错' : 'Solved by math, not trial and error'}
        </p>

        <div class="grid md:grid-cols-2 gap-10 items-center">
          <!-- Explanation -->
          <div class="space-y-6 data-animate">
            <div class="bg-white/5 border border-cyan-500/20 rounded-2xl p-6">
              <h3 class="text-xl font-bold text-cyan-300 mb-4">
                {currentLang === 'fr' ? 'Le LiDAR : 128 rayons sur 240°' : currentLang === 'zh' ? 'LiDAR：240°内128条射线' : 'The LiDAR: 128 rays over 240°'}
              </h3>
              <div class="space-y-3 text-slate-300 text-sm leading-relaxed">
                <p>{currentLang === 'fr'
                  ? 'Résolution angulaire entre deux rayons :'
                  : currentLang === 'zh' ? '两条射线间的角分辨率：' : 'Angular resolution between two rays:'}
                  <span class="text-cyan-300 font-bold font-mono ml-2">240° / 128 = 1.89°</span>
                </p>
                <p>{currentLang === 'fr'
                  ? 'Angle couvert par un arbre de 30 cm vu à 20 m :'
                  : currentLang === 'zh' ? '20m处30cm半径树木的覆盖角度：' : 'Angle covered by a 30cm tree at 20m:'}
                  <span class="text-orange-300 font-bold font-mono ml-2">2×arctan(0.3/20) ≈ 1.72°</span>
                </p>
                <div class="bg-orange-500/10 border border-orange-500/30 rounded-xl p-4 mt-2">
                  <p class="text-orange-200 font-semibold">
                    {currentLang === 'fr'
                      ? '1.72° < 1.89° → Au-delà de ~18 m, l\'arbre passe entre deux rayons et reste invisible.'
                      : currentLang === 'zh'
                      ? '1.72° < 1.89° → 超过约18m，树木可能从射线间隙穿过而不被探测到。'
                      : '1.72° < 1.89° → Beyond ~18m, the tree slips between two rays and stays invisible.'}
                  </p>
                </div>
              </div>
            </div>

            <div class="bg-emerald-500/10 border border-emerald-500/30 rounded-2xl p-6">
              <h3 class="text-xl font-bold text-emerald-300 mb-3">
                {currentLang === 'fr' ? '→ Capteur Fovéal' : currentLang === 'zh' ? '→ 中央凹传感器' : '→ Foveal Sensor'}
              </h3>
              <p class="text-slate-300 text-sm leading-relaxed">
                {currentLang === 'fr'
                  ? 'Même nombre de rayons, mais concentrés vers l\'avant — comme la fovéa de l\'œil humain. La résolution angulaire devant est bien inférieure à 1.72°, rendant chaque arbre détectable à grande distance.'
                  : currentLang === 'zh'
                  ? '相同数量的射线，但集中在前方——类似人眼中央凹。前方角分辨率远低于1.72°，使每棵树在远处都能被探测到。'
                  : 'Same number of rays, but concentrated forward — like the human eye\'s fovea. Forward angular resolution drops well below 1.72°, making every tree detectable at distance.'}
              </p>
            </div>
          </div>

          <!-- Visual diagram -->
          <div class="data-animate">
            <div class="bg-slate-950 rounded-2xl border border-slate-700 overflow-hidden aspect-square flex items-center justify-center relative">
              <!-- SVG LiDAR diagram -->
              <svg viewBox="0 0 400 400" class="w-full h-full p-8" aria-label="LiDAR foveal diagram">
                <defs>
                  <radialGradient id="droneGlow" cx="50%" cy="80%" r="30%">
                    <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.4"/>
                    <stop offset="100%" stop-color="#06b6d4" stop-opacity="0"/>
                  </radialGradient>
                </defs>
                <ellipse cx="200" cy="340" rx="120" ry="60" fill="url(#droneGlow)"/>

                <!-- === LEFT: Uniform rays === -->
                <text x="22" y="22" fill="#94a3b8" font-size="11" font-family="monospace">Uniform (before)</text>
                <!-- 9 uniform rays, -60° to +60° step 15° -->
                <line x1="90" y1="330" x2="25" y2="265" stroke="#ef4444" stroke-width="1" stroke-opacity="0.6"/>
                <line x1="90" y1="330" x2="42" y2="244" stroke="#ef4444" stroke-width="1" stroke-opacity="0.6"/>
                <line x1="90" y1="330" x2="63" y2="232" stroke="#ef4444" stroke-width="1" stroke-opacity="0.6"/>
                <line x1="90" y1="330" x2="84" y2="256" stroke="#ef4444" stroke-width="1" stroke-opacity="0.6"/>
                <line x1="90" y1="330" x2="90" y2="255" stroke="#ef4444" stroke-width="1" stroke-opacity="0.6"/>
                <line x1="90" y1="330" x2="109" y2="256" stroke="#ef4444" stroke-width="1" stroke-opacity="0.6"/>
                <line x1="90" y1="330" x2="130" y2="268" stroke="#ef4444" stroke-width="1" stroke-opacity="0.6"/>
                <line x1="90" y1="330" x2="145" y2="288" stroke="#ef4444" stroke-width="1" stroke-opacity="0.6"/>
                <line x1="90" y1="330" x2="155" y2="265" stroke="#ef4444" stroke-width="1" stroke-opacity="0.6"/>
                <circle cx="90" cy="330" r="6" fill="#06b6d4"/>
                <text x="108" y="248" fill="#f97316" font-size="9" font-family="monospace">blind</text>
                <text x="108" y="259" fill="#f97316" font-size="9" font-family="monospace">zone</text>

                <!-- === RIGHT: Foveal rays === -->
                <text x="218" y="22" fill="#94a3b8" font-size="11" font-family="monospace">Foveal (after)</text>
                <!-- angles: -55,-35,-18,-8,0,8,18,35,55 — outer rays teal, center cyan+wider -->
                <line x1="310" y1="330" x2="237" y2="278" stroke="#14b8a6" stroke-width="1" stroke-opacity="0.7"/>
                <line x1="310" y1="330" x2="258" y2="256" stroke="#14b8a6" stroke-width="1" stroke-opacity="0.7"/>
                <line x1="310" y1="330" x2="282" y2="244" stroke="#14b8a6" stroke-width="1" stroke-opacity="0.7"/>
                <line x1="310" y1="330" x2="297" y2="241" stroke="#22d3ee" stroke-width="2" stroke-opacity="1"/>
                <line x1="310" y1="330" x2="310" y2="240" stroke="#22d3ee" stroke-width="2" stroke-opacity="1"/>
                <line x1="310" y1="330" x2="323" y2="241" stroke="#22d3ee" stroke-width="2" stroke-opacity="1"/>
                <line x1="310" y1="330" x2="338" y2="244" stroke="#14b8a6" stroke-width="1" stroke-opacity="0.7"/>
                <line x1="310" y1="330" x2="362" y2="256" stroke="#14b8a6" stroke-width="1" stroke-opacity="0.7"/>
                <line x1="310" y1="330" x2="383" y2="278" stroke="#14b8a6" stroke-width="1" stroke-opacity="0.7"/>
                <circle cx="310" cy="330" r="6" fill="#06b6d4"/>
                <text x="252" y="210" fill="#22d3ee" font-size="9" font-family="monospace">fine coverage</text>
                <text x="296" y="226" fill="#22d3ee" font-size="8" font-family="monospace">↑ fovea</text>

                <!-- Divider -->
                <line x1="200" y1="10" x2="200" y2="390" stroke="#334155" stroke-width="1" stroke-dasharray="6 4"/>
              </svg>
            </div>
            <!-- Clip placeholder for LiDAR view -->
            <div class="mt-4 bg-slate-900 border border-slate-700 rounded-xl p-4 flex items-center gap-3 text-sm text-slate-400">
              <svg class="w-5 h-5 shrink-0 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>{currentLang === 'fr' ? 'Clip « Vue LiDAR » à intégrer' : currentLang === 'zh' ? '待集成"LiDAR视图"片段' : '"LiDAR View" clip to be added'}</span>
              <span class="ml-auto font-mono text-xs text-slate-600">lidar-view.gif</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         BUGS RÉVÉLATEURS
    ═══════════════════════════════════════ -->
