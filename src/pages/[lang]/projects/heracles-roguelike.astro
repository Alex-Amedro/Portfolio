  @keyframes slideUp {
    from {
      transform: translateY(30px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  [data-animate] {
    animation: slideUp 0.8s ease-out forwards;
  }

  html {
    scroll-behavior: smooth;
  }

  details[open] summary svg {
    transform: rotate(180deg);
  }
</style>
