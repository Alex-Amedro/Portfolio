---
// src/pages/cam.astro
// Page temporaire pour l'examen CAM - lecteur vidéo vertical (format téléphone)
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CAM – Alexandre Amedro</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --bg: #0a0a0f;
        --surface: #12121a;
        --surface2: #1a1a26;
        --accent: #6c63ff;
        --accent2: #a78bfa;
        --text: #e2e8f0;
        --text-muted: #94a3b8;
        --border: rgba(108, 99, 255, 0.25);
        --glow: rgba(108, 99, 255, 0.4);
      }

      html, body {
        height: 100%;
        font-family: 'Inter', sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        background:
          radial-gradient(ellipse 80% 50% at 50% -10%, rgba(108, 99, 255, 0.15) 0%, transparent 60%),
          radial-gradient(ellipse 60% 40% at 80% 90%, rgba(167, 139, 250, 0.08) 0%, transparent 50%),
          var(--bg);
      }

      /* ── Header ── */
      .cam-header {
        width: 100%;
        max-width: 900px;
        padding: 2rem 1.5rem 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .cam-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(108, 99, 255, 0.15);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.3rem 0.85rem;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent2);
      }

      .cam-badge .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 6px #22c55e;
        animation: blink 1.4s ease-in-out infinite;
      }

      @keyframes blink {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.3; }
      }

      .cam-title {
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        font-weight: 800;
        background: linear-gradient(135deg, #fff 30%, var(--accent2));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.2;
      }

      .cam-subtitle {
        color: var(--text-muted);
        font-size: 0.9rem;
        margin-top: 0.3rem;
      }

      /* ── Main layout ── */
      .cam-main {
        width: 100%;
        max-width: 900px;
        padding: 0 1.5rem 3rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
      }

      /* ── Video wrapper – format portrait 9:16 ── */
      .video-wrapper {
        position: relative;
        width: 100%;
        max-width: 360px;     /* max width for a "phone" feel */
        aspect-ratio: 9 / 16;
        border-radius: 20px;
        overflow: hidden;
        background: var(--surface);
        border: 1.5px solid var(--border);
        box-shadow:
          0 0 0 1px rgba(108,99,255,0.1),
          0 20px 60px rgba(0,0,0,0.6),
          0 0 80px rgba(108,99,255,0.12);
        transition: box-shadow 0.3s ease;
      }

      .video-wrapper:hover {
        box-shadow:
          0 0 0 1px rgba(108,99,255,0.25),
          0 20px 60px rgba(0,0,0,0.7),
          0 0 100px rgba(108,99,255,0.22);
      }

      /* Decorative "phone notch" strip at the top */
      .video-wrapper::before {
        content: '';
        position: absolute;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 5px;
        border-radius: 999px;
        background: rgba(255,255,255,0.12);
        z-index: 10;
        pointer-events: none;
      }

      .video-wrapper video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        border-radius: 18px;
      }

      /* Overlay when no video is loaded */
      .video-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        color: var(--text-muted);
        font-size: 0.9rem;
        text-align: center;
        padding: 2rem;
        background: var(--surface);
        border-radius: 18px;
        pointer-events: none;
      }

      .video-placeholder svg {
        opacity: 0.35;
      }

      .video-placeholder.hidden {
        display: none;
      }

      /* ── Upload zone ── */
      .upload-zone {
        width: 100%;
        max-width: 360px;
        border: 2px dashed var(--border);
        border-radius: 16px;
        padding: 1.8rem 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.8rem;
        cursor: pointer;
        transition: all 0.25s ease;
        background: var(--surface);
        position: relative;
        overflow: hidden;
      }

      .upload-zone::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at center, rgba(108,99,255,0.06) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.3s;
      }

      .upload-zone:hover,
      .upload-zone.dragover {
        border-color: var(--accent);
        background: rgba(108, 99, 255, 0.08);
      }

      .upload-zone:hover::after,
      .upload-zone.dragover::after {
        opacity: 1;
      }

      .upload-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(108,99,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent2);
      }

      .upload-zone p {
        font-size: 0.85rem;
        color: var(--text-muted);
        text-align: center;
        line-height: 1.5;
      }

      .upload-zone span {
        color: var(--accent2);
        font-weight: 600;
      }

      .upload-zone input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
      }

      /* ── URL input ── */
      .url-section {
        width: 100%;
        max-width: 360px;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .url-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .url-row {
        display: flex;
        gap: 0.5rem;
      }

      .url-input {
        flex: 1;
        background: var(--surface2);
        border: 1.5px solid var(--border);
        border-radius: 10px;
        padding: 0.65rem 1rem;
        color: var(--text);
        font-family: 'Inter', sans-serif;
        font-size: 0.85rem;
        outline: none;
        transition: border-color 0.2s;
      }

      .url-input::placeholder {
        color: var(--text-muted);
        opacity: 0.6;
      }

      .url-input:focus {
        border-color: var(--accent);
      }

      .url-btn {
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.65rem 1.1rem;
        font-family: 'Inter', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s;
        white-space: nowrap;
      }

      .url-btn:hover  { opacity: 0.9; transform: translateY(-1px); }
      .url-btn:active { transform: translateY(0); }

      /* ── Filename display ── */
      .file-info {
        width: 100%;
        max-width: 360px;
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 0.7rem 1rem;
        font-size: 0.82rem;
        color: var(--accent2);
        display: none;
        align-items: center;
        gap: 0.5rem;
        word-break: break-all;
      }

      .file-info.visible { display: flex; }

      /* ── Back link ── */
      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--text-muted);
        font-size: 0.82rem;
        text-decoration: none;
        transition: color 0.2s;
        margin-top: 0.5rem;
        align-self: flex-start;
      }

      .back-link:hover { color: var(--accent2); }

      /* ── Divider ── */
      .divider {
        width: 100%;
        max-width: 360px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--text-muted);
        font-size: 0.75rem;
      }

      .divider::before,
      .divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border);
      }
    </style>
  </head>

  <body>
    <header class="cam-header">
      <div>
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.4rem;">
          <span class="cam-badge"><span class="dot"></span>CAM</span>
        </div>
        <h1 class="cam-title">Lecteur Vidéo</h1>
        <p class="cam-subtitle">Page temporaire · Examen CAM · Format vertical (9:16)</p>
      </div>
    </header>

    <main class="cam-main">

      <!-- Back link -->
      <a href="/" class="back-link" style="align-self:flex-start;max-width:360px;width:100%;">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        Retour au portfolio
      </a>

      <!-- Video player – portrait 9:16 -->
      <div class="video-wrapper" id="videoWrapper">
        <!-- Notch decoration is via ::before pseudo-element -->

        <div class="video-placeholder" id="videoPlaceholder">
          <svg width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
            <path d="M8 21h8M12 17v4"/>
          </svg>
          <span>Aucune vidéo chargée</span>
          <span style="font-size:0.78rem;opacity:0.7;">Importe un fichier ou colle une URL ci-dessous</span>
        </div>

        <video id="videoPlayer" controls playsinline style="display:none;">
          Votre navigateur ne supporte pas la lecture vidéo.
        </video>
      </div>

      <!-- File upload zone -->
      <div class="upload-zone" id="uploadZone">
        <input type="file" id="fileInput" accept="video/*" />
        <div class="upload-icon">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
        </div>
        <p><span>Clique pour choisir</span> ou glisse ta vidéo ici<br/>MP4, MOV, WebM… — format vertical recommandé</p>
      </div>

      <!-- Loaded file name -->
      <div class="file-info" id="fileInfo">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.069A1 1 0 0121 8.868V15.5M3 8l9 5 9-5M3 8v8l9 5 9-5V8"/>
        </svg>
        <span id="fileInfoName"></span>
      </div>

      <!-- OR divider -->
      <div class="divider" style="max-width:360px;width:100%;">ou</div>

      <!-- URL input -->
      <div class="url-section">
        <label class="url-label" for="urlInput">URL de la vidéo</label>
        <div class="url-row">
          <input
            type="url"
            id="urlInput"
            class="url-input"
            placeholder="https://example.com/video.mp4"
          />
          <button class="url-btn" id="urlBtn">Charger</button>
        </div>
      </div>

    </main>

    <script>
      const fileInput       = document.getElementById('fileInput') as HTMLInputElement;
      const urlInput        = document.getElementById('urlInput')  as HTMLInputElement;
      const urlBtn          = document.getElementById('urlBtn')     as HTMLButtonElement;
      const uploadZone      = document.getElementById('uploadZone') as HTMLElement;
      const videoPlayer     = document.getElementById('videoPlayer') as HTMLVideoElement;
      const videoPlaceholder = document.getElementById('videoPlaceholder') as HTMLElement;
      const fileInfo        = document.getElementById('fileInfo')   as HTMLElement;
      const fileInfoName    = document.getElementById('fileInfoName') as HTMLElement;

      function loadVideo(src: string, name?: string) {
        videoPlayer.src = src;
        videoPlayer.style.display = 'block';
        videoPlaceholder.classList.add('hidden');
        if (name) {
          fileInfoName.textContent = name;
          fileInfo.classList.add('visible');
        }
        videoPlayer.play().catch(() => {});
      }

      // File pick
      fileInput.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        if (!file) return;
        const url = URL.createObjectURL(file);
        loadVideo(url, file.name);
      });

      // Drag & drop
      uploadZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadZone.classList.add('dragover');
      });
      uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'));
      uploadZone.addEventListener('drop', (e) => {
        e.preventDefault();
        uploadZone.classList.remove('dragover');
        const file = e.dataTransfer?.files[0];
        if (file && file.type.startsWith('video/')) {
          const url = URL.createObjectURL(file);
          loadVideo(url, file.name);
        }
      });

      // URL load
      urlBtn.addEventListener('click', () => {
        const src = urlInput.value.trim();
        if (!src) return;
        loadVideo(src);
        fileInfoName.textContent = src;
        fileInfo.classList.add('visible');
      });

      urlInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') urlBtn.click();
      });
    </script>
  </body>
</html>
